<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules. Excludes app settings (encrypted secrets)
    from cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
